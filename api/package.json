{
  "name": "glassbox-api",
  "version": "0.1.0",
  "description": "glassBox API — CRUD + approval actions over a pluggable store. Ships NO LLM (BYO-tokens).",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/cosmos": "^4.2.0",
    "@azure/functions": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
